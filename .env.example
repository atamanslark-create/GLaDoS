# GLaDoS — пример конфигурации
# Скопируйте этот файл в .env и заполните значения:
#   cp .env.example .env

# ── Обязательные ──────────────────────────────────────────────────────────────
# Токен бота из @BotFather
GLADOS_TOKEN=

# Ваш числовой Telegram user ID (узнать у @userinfobot)
GLADOS_OWNER_ID=

# ── PIN-защита (необязательно) ─────────────────────────────────────────────────
# Числовой PIN для защиты сессии. Оставьте пустым чтобы отключить.
# GLADOS_PIN=

# Время жизни сессии в минутах (по умолчанию 30)
# GLADOS_PIN_TIMEOUT=30

# ── Пути ─────────────────────────────────────────────────────────────────────
# Каталог для базы данных и ключей (по умолчанию ./data)
# GLADOS_DATA_DIR=/opt/glados/data

# ── Прочее ────────────────────────────────────────────────────────────────────
# За сколько дней предупреждать об истечении подписки
# GLADOS_WARN_DAYS=5

# Время ежедневной проверки подписок (HH:MM)
# GLADOS_CHECK_TIME=10:00

# Интервал мониторинга ботов в минутах
# GLADOS_BOT_MONITOR_MIN=60

# Максимальный размер загружаемого файла в МБ
# GLADOS_MAX_FILE_MB=20
